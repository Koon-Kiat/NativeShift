<Window
    x:Class="NativeShift.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NativeShift">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.Resources>
            <SolidColorBrush x:Key="NativeShiftTealBrush" Color="#14B8A6" />
            <SolidColorBrush x:Key="NativeShiftAmberBrush" Color="#F59E0B" />
        </Grid.Resources>
        <NavigationView
            x:Name="Navigation"
            PaneDisplayMode="LeftCompact"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="Navigation_SelectionChanged"
            AutomationProperties.Name="Application pages">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Convert" Icon="Switch" Tag="convert" />
                <NavigationViewItem Content="Settings" Icon="Setting" Tag="settings" />
                <NavigationViewItem Content="Capabilities" Icon="AllApps" Tag="capabilities" />
                <NavigationViewItem Content="About" Icon="Help" Tag="about" />
            </NavigationView.MenuItems>
            <Grid Margin="24,16,24,24">
                <Grid x:Name="ConvertPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Text="NativeShift" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock
                            Text="Private, local conversion for images, audio, and video."
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Border
                        x:Name="DropArea"
                        Grid.Row="1"
                        Margin="0,16,0,12"
                        Padding="24"
                        MinHeight="108"
                        BorderBrush="{StaticResource NativeShiftTealBrush}"
                        BorderThickness="2"
                        CornerRadius="12"
                        AllowDrop="True"
                        DragOver="DropArea_DragOver"
                        Drop="DropArea_Drop"
                        AutomationProperties.Name="Drop files or folders for conversion">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="28" />
                            <TextBlock Text="Drop files or folders here" FontSize="18" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <Button Content="Add Files" AccessKey="F" Click="AddFiles_Click" />
                                <Button Content="Add Folder" AccessKey="D" Click="AddFolder_Click" />
                                <CheckBox x:Name="RecursiveFolders" Content="Include subfolders" IsChecked="True" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" ColumnSpacing="8" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="SearchBox"
                            PlaceholderText="Search queue"
                            Header="Queue filter"
                            TextChanged="SearchBox_TextChanged"
                            AutomationProperties.Name="Search conversion queue" />
                        <ComboBox
                            x:Name="StateFilter"
                            Grid.Column="1"
                            Header="Status"
                            SelectedIndex="0">
                            <ComboBoxItem Content="All" />
                            <ComboBoxItem Content="pending" />
                            <ComboBoxItem Content="converting" />
                            <ComboBoxItem Content="completed" />
                            <ComboBoxItem Content="completed_with_warnings" />
                            <ComboBoxItem Content="failed" />
                            <ComboBoxItem Content="cancelled" />
                        </ComboBox>
                        <ComboBox
                            x:Name="OutputFormat"
                            Grid.Column="2"
                            Header="Output format"
                            SelectedIndex="0"
                            AutomationProperties.Name="Output format">
                            <ComboBoxItem Content="png" />
                            <ComboBoxItem Content="jpeg" />
                            <ComboBoxItem Content="webp" />
                            <ComboBoxItem Content="bmp" />
                            <ComboBoxItem Content="tiff" />
                            <ComboBoxItem Content="mp3" />
                            <ComboBoxItem Content="wav" />
                            <ComboBoxItem Content="flac" />
                            <ComboBoxItem Content="aac" />
                            <ComboBoxItem Content="m4a" />
                            <ComboBoxItem Content="ogg" />
                            <ComboBoxItem Content="opus" />
                            <ComboBoxItem Content="mp4" />
                            <ComboBoxItem Content="mkv" />
                            <ComboBoxItem Content="webm" />
                        </ComboBox>
                    </Grid>

                    <Grid Grid.Row="3" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" MinWidth="280" />
                        </Grid.ColumnDefinitions>
                        <ListView
                            x:Name="QueueList"
                            SelectionMode="Single"
                            SelectionChanged="QueueList_SelectionChanged"
                            AutomationProperties.Name="Conversion queue">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="48" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <ScrollViewer Grid.Column="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Job details" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="DetailsText"
                                    Text="Select a queue item to inspect progress, output path, codec, warnings, or errors."
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True"
                                    AutomationProperties.Name="Selected job details" />
                                <Expander Header="Conversion settings" IsExpanded="True">
                                    <StackPanel Padding="0,8,0,0" Spacing="8">
                                        <ComboBox x:Name="PresetSelector" Header="Preset" SelectedIndex="0">
                                            <ComboBoxItem Content="Custom" />
                                            <ComboBoxItem Content="JPEG high quality" Tag="jpeg-high" />
                                            <ComboBoxItem Content="WebP balanced" Tag="webp-balanced" />
                                            <ComboBoxItem Content="MP3 high quality" Tag="mp3-high" />
                                            <ComboBoxItem Content="Opus voice" Tag="opus-voice" />
                                            <ComboBoxItem Content="MP4 H.264 compatibility" Tag="mp4-h264" />
                                            <ComboBoxItem Content="WebM VP9" Tag="webm-vp9" />
                                        </ComboBox>
                                        <NumberBox x:Name="Quality" Header="Quality" Value="85" Minimum="1" Maximum="100" />
                                        <ComboBox x:Name="AudioCodec" Header="Audio codec" SelectedIndex="0">
                                            <ComboBoxItem Content="Automatic" Tag="automatic" />
                                            <ComboBoxItem Content="MP3" Tag="mp3" />
                                            <ComboBoxItem Content="PCM 16-bit" Tag="pcm" />
                                            <ComboBoxItem Content="FLAC" Tag="flac" />
                                            <ComboBoxItem Content="AAC" Tag="aac" />
                                            <ComboBoxItem Content="Vorbis" Tag="vorbis" />
                                            <ComboBoxItem Content="Opus" Tag="opus" />
                                            <ComboBoxItem Content="Stream copy" Tag="copy" />
                                        </ComboBox>
                                        <NumberBox x:Name="AudioBitrate" Header="Audio bitrate (kbps)" Value="192" Minimum="8" Maximum="1536" />
                                        <ComboBox x:Name="VideoCodec" Header="Video codec" SelectedIndex="0">
                                            <ComboBoxItem Content="Automatic" Tag="automatic" />
                                            <ComboBoxItem Content="H.264" Tag="h264" />
                                            <ComboBoxItem Content="H.265 / HEVC" Tag="h265" />
                                            <ComboBoxItem Content="VP9" Tag="vp9" />
                                            <ComboBoxItem Content="AV1" Tag="av1" />
                                            <ComboBoxItem Content="Stream copy" Tag="copy" />
                                        </ComboBox>
                                        <NumberBox x:Name="VideoQuality" Header="Video quality (codec scale)" Value="23" Minimum="0" Maximum="63" />
                                        <NumberBox x:Name="Width" Header="Width (optional)" Minimum="1" SpinButtonPlacementMode="Compact" />
                                        <NumberBox x:Name="Height" Header="Height (optional)" Minimum="1" SpinButtonPlacementMode="Compact" />
                                        <ComboBox x:Name="HardwareMode" Header="Hardware acceleration" SelectedIndex="0">
                                            <ComboBoxItem Content="Automatic" Tag="auto" />
                                            <ComboBoxItem Content="Prefer hardware" Tag="prefer" />
                                            <ComboBoxItem Content="Software only" Tag="software" />
                                        </ComboBox>
                                        <CheckBox x:Name="PreserveMetadata" Content="Preserve metadata where supported" />
                                        <ComboBox x:Name="ConflictPolicy" Header="Existing output" SelectedIndex="3">
                                            <ComboBoxItem Content="Ask" Tag="ask" />
                                            <ComboBoxItem Content="Skip" Tag="skip" />
                                            <ComboBoxItem Content="Replace" Tag="replace" />
                                            <ComboBoxItem Content="Generate unique name" Tag="unique" />
                                        </ComboBox>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <StackPanel Grid.Row="4" Margin="0,12,0,0" Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputFolder" Header="Output folder (blank uses the source folder)" IsReadOnly="True" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse" Click="BrowseOutput_Click" />
                        </Grid>
                        <ProgressBar x:Name="OverallProgress" Minimum="0" Maximum="100" AutomationProperties.Name="Overall conversion progress" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="Convert"
                                AccessKey="C"
                                Background="{StaticResource NativeShiftAmberBrush}"
                                Foreground="Black"
                                Click="Convert_Click" />
                            <Button Content="Pause Queue" Click="Pause_Click" />
                            <Button Content="Resume Queue" Click="Resume_Click" />
                            <Button Content="Cancel Selected" Click="CancelSelected_Click" />
                            <Button Content="Cancel All" Click="CancelAll_Click" />
                            <Button Content="Retry Selected" Click="RetrySelected_Click" />
                            <Button Content="Remove Selected" Click="RemoveSelected_Click" />
                            <Button Content="Clear Completed" Click="ClearCompleted_Click" />
                            <Button Content="Open Output Folder" Click="OpenOutput_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="12">
                        <TextBlock Text="Application settings" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Settings are stored per user under LocalAppData\NativeShift and contain no file contents." TextWrapping="Wrap" />
                        <ComboBox x:Name="ThemeSetting" Header="Theme" SelectedIndex="0">
                            <ComboBoxItem Content="Use system setting" Tag="system" />
                            <ComboBoxItem Content="Light" Tag="light" />
                            <ComboBoxItem Content="Dark" Tag="dark" />
                        </ComboBox>
                        <NumberBox x:Name="MaximumJobsSetting" Header="Maximum concurrent conversions (takes effect after restart)" Minimum="1" Maximum="32" Value="2" />
                        <ComboBox x:Name="LoggingSetting" Header="Logging level" SelectedIndex="1">
                            <ComboBoxItem Content="Debug (may include full paths)" Tag="debug" />
                            <ComboBoxItem Content="Information" Tag="information" />
                            <ComboBoxItem Content="Warning" Tag="warning" />
                            <ComboBoxItem Content="Error" Tag="error" />
                        </ComboBox>
                        <ToggleSwitch x:Name="NotificationsSetting" Header="Completion notifications" IsOn="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Save settings" Click="SaveSettings_Click" />
                            <Button Content="Reset settings to defaults" Click="ResetSettings_Click" />
                            <Button Content="Open logs folder" Click="OpenLogs_Click" />
                            <Button Content="Copy diagnostic summary" Click="CopyDiagnostics_Click" />
                        </StackPanel>
                        <TextBlock x:Name="SettingsStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="CapabilitiesPage" Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Supported formats and capabilities" FontSize="28" FontWeight="SemiBold" />
                        <Button Content="Refresh capabilities" Click="RefreshCapabilities_Click" HorizontalAlignment="Left" />
                        <TextBlock
                            x:Name="CapabilitiesText"
                            Text="Select Refresh capabilities to inspect registered FFmpeg encoders and usable hardware devices."
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AboutPage" Visibility="Collapsed">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="12">
                        <TextBlock Text="About NativeShift" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Version 0.1.0" />
                        <TextBlock Text="NativeShift converts supported files locally. It has no cloud upload, account, analytics, advertising, or mandatory telemetry." TextWrapping="Wrap" />
                        <TextBlock Text="Codec and licensing information" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="This build uses dynamically linked FFmpeg libraries configured without GPL-only or nonfree components. Codec patent rights vary by country and use case. See THIRD_PARTY_NOTICES.md and docs/licensing.md in the distribution." TextWrapping="Wrap" />
                        <TextBlock Text="Copyright and licence details are included with every release artifact." TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
